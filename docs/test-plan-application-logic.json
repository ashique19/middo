{
  "id": "middo-tp-application-logic",
  "version": 1,
  "title": "Middo Application Logic & Calculation Flaw Hunt",
  "purpose": "Prove correctness of formulas, allocations, status machines, idempotency, concurrency, and ledger invariants — every calculation checked with numeric oracles.",
  "methodology": {
    "goal": "Find flaws where code computes wrong money/qty/status even when the user followed the business rules.",
    "not_in_scope": [
      "Whether a business policy is commercially wise (that is Plan A)",
      "Visual UI only"
    ],
    "approach": [
      "For every formula: hand-compute expected integer Taka before acting",
      "Assert DB columns and derived helpers (amountDue, cashCollectedAmount, isPaid) together",
      "Invariant checks after every transition: ledgers balance, no double events, box count = quantity",
      "Concurrency: parallel requests with locks; assert exactly-one winner",
      "Idempotency: replay callbacks/actions; assert no double credit",
      "Property-style cases: qty 1..N, discount 0/partial/full, fees on/off, single/multi-date"
    ],
    "money_conventions": {
      "unit": "integer Taka (no paisa)",
      "display_may_be_float": true,
      "persist_must_be_int": true
    },
    "pass_criteria": "Numeric expected === actual for all money fields; status+ledger invariants hold; replay safe.",
    "priority": {
      "P0": "Wrong customer charge/refund, double pay, phantom due, wrong handover cash, share math error",
      "P1": "Allocation remainder off-by-one, idempotency gaps, float round mismatch",
      "P2": "Display float vs int drift without money impact",
      "P3": "Log label only"
    }
  },
  "canonical_formulas": {
    "order_line_food": "food = (int) round(menu.price * qty)",
    "order_line_total": "total_amount = food + fees_for_date",
    "amount_due": "amountDue = max(0, total_amount - amount_paid)  // NOTE: discount_amount NOT subtracted",
    "is_paid_helper": "isPaid = (order_status==delivered_and_paid) OR (payment_status==paid)",
    "prepay_ratio": "receiver_mismatch ? 1.0 : (active+new_dates > 3 ? 0.5 : 0)",
    "prepay_amount": "round(cartTotal * ratio)",
    "allocate_largest_remainder": "split prepaid/discount across lines capped per line",
    "package_food_total": "billable_days * price_per_day * quantity",
    "package_payable": "max(0, foodTotal - discount) + chargesTotal",
    "day_order_line": "price_per_day * quantity  // charges/discount NOT on day orders",
    "money_flow_breakdown": {
      "qty": "max(1, quantity)",
      "kitchen": "menu.kitchen_commission * qty",
      "delivery": "menu.delivery_commission * qty",
      "billNet": "max(0, food + charges - discount)",
      "middoRest": "max(0, billNet - kitchen - delivery)"
    },
    "cash_collected_amount": "cash_collected>0 ? cash_collected : (isPaid && prepaid_amount==0 && status==delivered_and_paid ? total_amount : 0)",
    "wallet": "credit/debit ints with lockForUpdate; reject insufficient",
    "grouping_fit": "sum(group.qtys) + order.qty <= auto_meal_group_quantity (default 10)"
  },
  "global_invariants": [
    "INV-1: For any order, amount_paid >= 0 and amount_paid <= total_amount after settle paths (except document if overpay possible)",
    "INV-2: amountDue() == max(0, total_amount - amount_paid) always",
    "INV-3: When payment_status=paid AND discount_amount>0, customer economic due must be 0 — if amountDue()>0 this is a calc flaw",
    "INV-4: Sum(WalletLedger deltas) == user.wallet_balance",
    "INV-5: MiddoCashLedger next balance_after never negative",
    "INV-6: At packed/on_the_way/delivered*, count(order_middo_boxes) == order.quantity",
    "INV-7: AccrueShares runs at most once per order (single middo_rest event)",
    "INV-8: Partner payable amount == commission*qty at accrual (or document clamp policy)",
    "INV-9: Handover.amount == sum(cashCollectedAmount of included orders)",
    "INV-10: Replay of EPS success callback does not double-credit wallet or double-mark paid"
  ],
  "suites": [
    {
